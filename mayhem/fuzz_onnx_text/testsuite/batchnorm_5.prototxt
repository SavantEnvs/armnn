
                   ir_version: 3
                   producer_name:  "CNTK"
                   producer_version:  "2.5.1"
                   domain:  "ai.cntk"
                   model_version: 1
                   graph {
                     name:  "CNTKGraph"
                     input {
                        name: "Input"
                        type {
                          tensor_type {
                            elem_type: 1
                            shape {
                              dim {
                                dim_value: 1
                              }
                              dim {
                                dim_value: 1
                              }
                              dim {
                                dim_value: 3
                              }
                              dim {
                                dim_value: 3
                              }
                            }
                          }
                        }
                      }
                      input {
                         name: "mean"
                         type {
                           tensor_type {
                             elem_type: 1
                             shape {
                               dim {
                                 dim_value: 1
                               }
                             }
                           }
                         }
                       }
                       input {
                          name: "var"
                          type {
                            tensor_type {
                              elem_type: 1
                              shape {
                                dim {
                                  dim_value: 1
                                }
                              }
                            }
                          }
                        }
                        input {
                           name: "scale"
                           type {
                             tensor_type {
                               elem_type: 1
                               shape {
                                 dim {
                                   dim_value: 1
                                 }
                               }
                             }
                           }
                         }
                         input {
                            name: "bias"
                            type {
                              tensor_type {
                                elem_type: 1
                                shape {
                                  dim {
                                    dim_value: 1
                                  }
                                }
                              }
                            }
                          }
                     node {
                         input: "Input"
                         input: "scale"
                         input: "bias"
                         input: "mean"
                         input: "var"
                         output: "Output"
                         name: "batchNorm"
                         op_type: "BatchNormalization"
                         attribute {
                           name: "epsilon"
                           f:  0.0010000000475
                           type: 1
                         }
                      }
                      initializer {
                          dims: 1
                          data_type: 1
                          float_data: 5.0
                          name: "mean"
                        }
                      initializer {
                        dims: 1
                        data_type: 1
                        float_data: 2.0
                        name: "var"
                      }
                      initializer {
                        dims: 1
                        data_type: 1
                        float_data: 0.0
                        name: "bias"
                      }
                      initializer {
                        dims: 1
                        data_type: 1
                        float_data: 1.0
                        name: "scale"
                      }
                      output {
                          name: "Output"
                          type {
                             tensor_type {
                               elem_type: 1
                               shape {
                                   dim {
                                       dim_value: 1
                                   }
                                   dim {
                                       dim_value: 1
                                   }
                                   dim {
                                       dim_value: 3
                                   }
                                   dim {
                                       dim_value: 3
                                   }
                               }
                            }
                        }
                        }
                    }
                   opset_import {
                      version: 7
                    }